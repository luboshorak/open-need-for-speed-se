<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>OpenNFS1</AssemblyName>
    <RootNamespace>OpenNFS1</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <Version>1.2.4</Version>
    <!-- Keep compiler/content errors visible instead of hiding MGCB output behind /quiet. -->
    <MonoGameMGCBAdditionalArguments>/incremental</MonoGameMGCBAdditionalArguments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engine\GameEngine.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
    <MonoGameContentReference Include="Content\Content.mgcb" />
    <None Update="gameconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="CD_Data\README.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
